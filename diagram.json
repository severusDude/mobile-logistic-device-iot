{
  "version": 1,
  "author": "Lutfi Fajar",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 200,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "chip-gps-neo6m",
      "id": "gps",
      "top": 50,
      "left": -150,
      "attrs": {}
    },
    {
      "type": "chip-pn532",
      "id": "pn532",
      "top": 50,
      "left": 100,
      "attrs": {}
    },
    {
      "type": "wokwi-breadboard",
      "id": "bb1",
      "top": 150,
      "left": 250,
      "attrs": {}
    },

    {
      "type": "wokwi-resistor",
      "id": "r_gps",
      "top": 195,
      "left": 266,
      "rotate": 90,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_rfid",
      "top": 195,
      "left": 316,
      "rotate": 90,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_mqtt",
      "top": 195,
      "left": 366,
      "rotate": 90,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_wifi",
      "top": 195,
      "left": 416,
      "rotate": 90,
      "attrs": { "value": "220" }
    },

    {
      "type": "wokwi-led",
      "id": "led_gps",
      "top": 255,
      "left": 266,
      "attrs": { "color": "red", "label": "GPS Fix" }
    },
    {
      "type": "wokwi-led",
      "id": "led_rfid",
      "top": 255,
      "left": 316,
      "attrs": { "color": "yellow", "label": "RFID" }
    },
    {
      "type": "wokwi-led",
      "id": "led_mqtt",
      "top": 255,
      "left": 366,
      "attrs": { "color": "green", "label": "MQTT" }
    },
    {
      "type": "wokwi-led",
      "id": "led_wifi",
      "top": 255,
      "left": 416,
      "attrs": { "color": "blue", "label": "WiFi" }
    }
  ],
  "connections": [
    ["esp:TX", "$serialMonitor:RX", "", []],
    ["esp:RX", "$serialMonitor:TX", "", []],

    ["esp:GND.1", "gps:GND", "black", []],
    ["esp:5V", "gps:VCC", "red", []],
    ["gps:TX", "esp:RX", "green", []],
    ["esp:TX", "gps:RX", "orange", []],

    ["esp:GND.2", "pn532:GND", "black", []],
    ["esp:3V3", "pn532:VCC", "red", []],
    ["pn532:SDA", "esp:21", "blue", []],
    ["esp:22", "pn532:SCL", "yellow", []],
    ["esp:19", "pn532:IRQ", "purple", []],
    ["esp:23", "pn532:RST", "orange", []],

    ["esp:GND.3", "bb1:bn.1", "black", []],

    ["esp:18", "bb1:2t.a", "red", []],
    ["esp:5", "bb1:7t.a", "yellow", []],
    ["esp:4", "bb1:12t.a", "green", []],
    ["esp:2", "bb1:17t.a", "blue", []],

    ["bb1:2t.e", "r_gps:1", "red", []],
    ["bb1:7t.e", "r_rfid:1", "yellow", []],
    ["bb1:12t.e", "r_mqtt:1", "green", []],
    ["bb1:17t.e", "r_wifi:1", "blue", []],

    ["r_gps:2", "bb1:4t.f", "red", []],
    ["r_rfid:2", "bb1:9t.f", "yellow", []],
    ["r_mqtt:2", "bb1:14t.f", "green", []],
    ["r_wifi:2", "bb1:19t.f", "blue", []],

    ["bb1:4t.j", "led_gps:A", "red", []],
    ["bb1:9t.j", "led_rfid:A", "yellow", []],
    ["bb1:14t.j", "led_mqtt:A", "green", []],
    ["bb1:19t.j", "led_wifi:A", "blue", []],

    ["led_gps:C", "bb1:bn.5", "black", []],
    ["led_rfid:C", "bb1:bn.10", "black", []],
    ["led_mqtt:C", "bb1:bn.15", "black", []],
    ["led_wifi:C", "bb1:bn.20", "black", []]
  ],
  "serialMonitor": {
    "convertEol": true,
    "display": "terminal",
    "newline": "lf"
  },
  "dependencies": {}
}
