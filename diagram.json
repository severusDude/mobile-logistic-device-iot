{
  "version": 1,
  "author": "GPS Logistic Tracking — Mobile Device (Truck)",
  "editor": "wokwi",
  "parts": [
    {
      "id": "esp",
      "type": "board-esp32-devkit-c-v4",
      "top": 160,
      "left": 200,
      "attrs": {}
    },
    {
      "id": "gps",
      "type": "chip-gps-neo6m",
      "top": 0,
      "left": 80,
      "attrs": {}
    },
    {
      "id": "pn532",
      "type": "chip-pn532",
      "top": 460,
      "left": 80,
      "attrs": {}
    },
    {
      "id": "led_wifi",
      "type": "wokwi-led",
      "top": 310,
      "left": 520,
      "attrs": { "color": "blue", "label": "WiFi" }
    },
    {
      "id": "led_mqtt",
      "type": "wokwi-led",
      "top": 260,
      "left": 520,
      "attrs": { "color": "green", "label": "MQTT" }
    },
    {
      "id": "led_rfid",
      "type": "wokwi-led",
      "top": 210,
      "left": 520,
      "attrs": { "color": "yellow", "label": "RFID" }
    },
    {
      "id": "led_gps",
      "type": "wokwi-led",
      "top": 160,
      "left": 520,
      "attrs": { "color": "red", "label": "GPS Fix" }
    },
    {
      "id": "r_wifi",
      "type": "wokwi-resistor",
      "top": 360,
      "left": 468,
      "rotate": 360,
      "attrs": { "value": "220" }
    },
    {
      "id": "r_mqtt",
      "type": "wokwi-resistor",
      "top": 310,
      "left": 468,
      "rotate": 360,
      "attrs": { "value": "220" }
    },
    {
      "id": "r_rfid",
      "type": "wokwi-resistor",
      "top": 260,
      "left": 468,
      "rotate": 360,
      "attrs": { "value": "220" }
    },
    {
      "id": "r_gps",
      "type": "wokwi-resistor",
      "top": 210,
      "left": 468,
      "rotate": 360,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    ["esp:TX", "$serialMonitor:RX", "", []],
    ["esp:RX", "$serialMonitor:TX", "", []],

    ["esp:GND.1", "gps:GND", "black", []],
    ["esp:VIN", "gps:VCC", "red", []],
    ["gps:TX", "esp:RX", "green", []],
    ["esp:TX", "gps:RX", "orange", []],

    ["esp:GND.2", "pn532:GND", "black", []],
    ["esp:3V3", "pn532:VCC", "red", []],
    ["pn532:SDA", "esp:21", "blue", []],
    ["esp:22", "pn532:SCL", "yellow", []],
    ["esp:19", "pn532:IRQ", "purple", []],
    ["esp:23", "pn532:RST", "orange", []],

    ["esp:2", "r_wifi:1", "blue", []],
    ["r_wifi:2", "led_wifi:A", "blue", []],
    ["led_wifi:K", "esp:GND.1", "black", []],

    ["esp:4", "r_mqtt:1", "green", []],
    ["r_mqtt:2", "led_mqtt:A", "green", []],
    ["led_mqtt:K", "esp:GND.1", "black", []],

    ["esp:5", "r_rfid:1", "yellow", []],
    ["r_rfid:2", "led_rfid:A", "yellow", []],
    ["led_rfid:K", "esp:GND.1", "black", []],

    ["esp:18", "r_gps:1", "red", []],
    ["r_gps:2", "led_gps:A", "red", []],
    ["led_gps:K", "esp:GND.1", "black", []]
  ],
  "serialMonitor": {
    "display": "terminal",
    "newline": "lf"
  }
}
